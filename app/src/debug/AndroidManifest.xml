<?xml version="1.0" encoding="utf-8"?><!-- Debug 构建专用 manifest 覆盖。仅在 debug build 中由 manifest merger 合并,
     release 不含此 provider 声明, 因此 release 包不会对外暴露内部存储。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="io.github.totomika.pocketmcp.documents.MCPDataFilesProvider"
            android:authorities="${applicationId}.datafiles"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- 透明 wake-up activity: 供外部文件管理器在目标进程未运行时拉活。
             noHistory + excludeFromRecents 确保用户无感知。 -->
        <activity
            android:name="io.github.totomika.pocketmcp.documents.MCPDataWakeUpActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>